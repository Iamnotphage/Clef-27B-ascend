--- a/vllm_ascend/device/device_op.py
+++ b/vllm_ascend/device/device_op.py
@@ -50,6 +50,17 @@ else:
     triton_q_rms = None  # type: ignore
 
 
+_GDN_BSND_ENABLED: bool | None = None
+
+
+def _gdn_bsnd_enabled() -> bool:
+    """Clef round-3 C1' switch: BSND layout for the A3 GDN prefill wrapper."""
+    global _GDN_BSND_ENABLED
+    if _GDN_BSND_ENABLED is None:
+        _GDN_BSND_ENABLED = os.environ.get("CLEF_GDN_BSND", "0") == "1"
+    return _GDN_BSND_ENABLED
+
+
 class BaseDeviceAdaptor:
     native_dcp_indexer = False
 
@@ -1020,6 +1031,60 @@ class BaseDeviceAdaptor:
         # Ascend versions make these queries safe before device selection.
         from vllm.third_party.flash_linear_attention.ops.l2norm import l2norm_fwd
 
+        # Clef round-3 candidate C1': pass sequence-major contiguous q/k/v with
+        # layout="BSND" (bit-exact against the BNSD path in the microrepro;
+        # removes the q/k/v transpose/contiguous pairs). Enabled by
+        # CLEF_GDN_BSND=1. The stable ABI silently mis-computes non-contiguous
+        # inputs under BSND (microrepro max-diff 0.889), so any non-contiguous
+        # or non-BF16 q/k/v falls back to the original conversion path.
+        if (
+            _gdn_bsnd_enabled()
+            and q.dim() == 4
+            and q.dtype == torch.bfloat16
+            and v.dtype == torch.bfloat16
+            and q.is_contiguous()
+            and k.is_contiguous()
+            and v.is_contiguous()
+        ):
+            q = l2norm_fwd(q).contiguous()
+            k = l2norm_fwd(k).contiguous()
+            v = v.contiguous()
+            g = g.to(torch.float32).contiguous()
+            beta = beta.to(v.dtype).contiguous()
+            initial_state_kern = initial_state.contiguous().transpose(-1, -2).contiguous()
+            cu_seqlens = prebuilt_meta.cu_seqlens_host
+            chunk_indices = prebuilt_meta.chunk_indices_chunk64_host
+            keep_meta = prebuilt_meta.keep_meta
+            if keep_meta is not None:
+                cu_seqlens = prebuilt_meta.cu_seqlens_kern
+                initial_state_kern = initial_state[keep_meta].transpose(-1, -2).contiguous()
+            output, final_state, *_ = fused_fwd(
+                q,
+                k,
+                v,
+                g,
+                beta,
+                initial_state=initial_state_kern,
+                output_final_state=True,
+                chunk_size=64,
+                cu_seqlens=cu_seqlens,
+                chunk_indices=chunk_indices,
+                scale=scale,
+                layout="BSND",
+                use_exp2=False,
+                use_qk_l2norm_in_kernel=False,
+                allow_neg_eigval=False,
+                disable_recompute=True,
+                state_v_first=False,
+            )
+            if keep_meta is not None:
+                # Scatter in the kernel layout so empty segments keep their
+                # initial state, then flip back to the caller's [.., Dv, Dk].
+                full_final_state = initial_state.transpose(-1, -2).contiguous()
+                full_final_state[keep_meta] = final_state
+                final_state = full_final_state
+            return output, final_state.transpose(-1, -2).contiguous()
+
         q = l2norm_fwd(q.contiguous()).contiguous()
         k = l2norm_fwd(k.contiguous()).contiguous()
         v = v.contiguous()
